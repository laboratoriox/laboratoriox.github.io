//@nome Cobrinha
//@name Snake
//@cor 0x0360
//@versao 1
//@desc Gire para virar e coma as moedas sem bater.
//@desc_en Turn to steer and eat the coins without crashing.

// Cobrinha - app do BitOS (BitScript)
var TOPO = 14
var COLS = 16
var LINS = 17
var T = 8
var Y0 = 20
var DX = [1, 0, -1, 0]
var DY = [0, 1, 0, -1]
var estado = 0
var pontos = 0
var recorde = 0
var novo = nao
var quadro = 0
var corpo = []          // posicoes y * COLS + x; a cabeca e a ultima
var dir = 0
var tempo = 0
var comida = 0
var vira = []           // viradas guardadas (no maximo 2)

func iniciar() { recorde = pega("recorde", 0); comecar() }
func comecar() {
  estado = 0; pontos = 0; novo = nao; dir = 0; tempo = 0; vira = []
  corpo = [8 * COLS + 4, 8 * COLS + 5, 8 * COLS + 6]
  novaComida()
}
func acabou() {
  estado = 2; acesa(nao)
  se pontos > recorde { recorde = pontos; novo = sim; guarda("recorde", recorde) }
}
func novaComida() {
  para (var t = 0; t < 500; t++) { var c = aleat(0, COLS * LINS - 1); se acha(corpo, c) < 0 { comida = c; retorna } }
}
func evento(e) {
  se estado == 2 { se e == CLIQUE { comecar() } retorna }
  se estado == 0 { estado = 1; acesa(sim) }
  se (e == CIMA || e == BAIXO) && tam(vira) < 2 { se e == CIMA { poe(vira, -1) } senao { poe(vira, 1) } }
}
func passo() {
  quadro++
  se estado != 1 { retorna }
  tempo++
  se tempo < max(7 - int(pontos / 6), 2) { retorna }
  tempo = 0
  se tam(vira) { dir = (dir + remove(vira, 0) + 4) % 4 }
  var cab = corpo[tam(corpo) - 1]
  var x = cab % COLS + DX[dir]; var y = int(cab / COLS) + DY[dir]
  se x < 0 || y < 0 || x >= COLS || y >= LINS { acabou(); retorna }
  var nova = y * COLS + x
  var come = nova == comida
  // sem comer, a ponta do rabo sai do lugar: a cabeca pode entrar onde ela estava
  se !come { remove(corpo, 0) }
  se acha(corpo, nova) >= 0 { acabou(); retorna }
  poe(corpo, nova)
  se come { pontos++; novaComida() }
}
func moedinha(x, y, r) { circ(x, y, r, BTC_E); circ(x, y, r - 1, BTC) }
func desenhar() {
  limpa(rgb(10, 24, 12))
  borda(0, Y0 - 1, COLS * T, LINS * T + 2, VERDE_E)
  moedinha(comida % COLS * T + 4, Y0 + int(comida / COLS) * T + 4, 4)
  var n = tam(corpo)
  para (var i = 0; i < n; i++) {
    var c = corpo[i]; var cor = VERDE_E
    se i == n - 1 { cor = VERDE } senao se (n - 1 - i) % 2 == 0 { cor = rgb(0, 160, 40) }
    retr(c % COLS * T, Y0 + int(c / COLS) * T, T - 1, T - 1, 2, cor)
  }
  var cab = corpo[n - 1]
  ret(cab % COLS * T + 3, Y0 + int(cab / COLS) * T + 3, 2, 2, PRETO)
  placar()
}
func placar() {
  ret(0, 0, 128, TOPO - 2, FUNDO)
  texto(3, 3, pontos); textod(125, 3, tr("Recorde ", "Best ") + recorde, 1, BTC)
  se estado == 0 {
    retr(8, 62, 112, 40, 8, FUNDO); bordar(8, 62, 112, 40, 8, BTC)
    textoc(64, 68, tr("Cobrinha", "Snake"), 1, BTC)
    textoc(64, 80, tr("gire: virar", "turn: steer"))
    textoc(64, 91, tr("cima:esq baixo:dir", "up:left down:right"), 1, CINZA)
  }
  se estado == 2 { fim() }
}
func fim() {
  retr(10, 44, 108, 76, 8, FUNDO); bordar(10, 44, 108, 76, 8, VERM)
  textoc(64, 50, tr("Fim de jogo", "Game over"), 1, VERM)
  textoc(64, 62, pontos, 2)
  se novo { se (quadro / 8) % 2 { textoc(64, 82, tr("Novo recorde!", "New record!"), 1, OURO) } }
  senao { textoc(64, 82, tr("Recorde ", "Best ") + recorde, 1, BTC) }
  textoc(64, 96, tr("clique: de novo", "click: again"))
  textoc(64, 107, tr("segure: menu", "hold: menu"), 1, CINZA)
}
func icone(x, y, c) {
  var P = [[-18, 10], [-10, 10], [-2, 10], [-2, 2], [-2, -6], [6, -6], [14, -6]]
  para (var i = 0; i < tam(P); i++) { retr(x + P[i][0], y + P[i][1], 8, 8, 2, VERDE) }
  ret(x + 18, y - 4, 2, 2, PRETO)
  moedinha(x + 16, y + 14, 5)
}
